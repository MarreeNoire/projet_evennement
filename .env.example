# =============================================================================
#  Plateforme événementielle — Variables d'environnement
#  1) Copier ce fichier en `.env.local`
#  2) Renseigner les valeurs (voir docs/DEPLOIEMENT.md)
#  3) Ne JAMAIS committer `.env.local`
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Rassemble"
NEXT_PUBLIC_CURRENCY=XOF

# Commission plateforme prélevée sur chaque commande (0.05 = 5 %)
PLATFORM_COMMISSION_RATE=0.05

# Mode paiement : "mock" (dev, sans clés) | "cinetpay" | "geniuspay"
PAYMENT_PROVIDER=mock

# Mode email : "console" (dev, pas d'envoi réel) | "resend" (production)
EMAIL_PROVIDER=console

# -----------------------------------------------------------------------------
# Supabase — obligatoire en production
# Tableau de bord : https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Clé serveur — NE JAMAIS exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Resend — emails transactionnels
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Rassemble <billets@tondomaine.ci>"
EMAIL_REPLY_TO=support@tondomaine.ci

# -----------------------------------------------------------------------------
# CinetPay — encaissement FCFA
# Tableau de bord : https://app.cinetpay.com
# -----------------------------------------------------------------------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
CINETPAY_CHANNELS=ALL

# -----------------------------------------------------------------------------
# GeniusPay — checkout hébergé (Wave, Orange Money, MTN, Moov et cartes)
# Tableau de bord GeniusPay : Paramètres → API
# Ne jamais exposer ces secrets dans le navigateur ni les committer.
# -----------------------------------------------------------------------------
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
# Webhook à déclarer dans le dashboard après déploiement :
# https://ton-domaine.ci/api/webhooks/geniuspay

# -----------------------------------------------------------------------------
# Crons (routes /api/cron/*)
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Optionnels
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_MAPS_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
